---
import type { Chart } from '../lib/validate-content'

interface Props {
  chart: Chart
  idPrefix?: string
}

const { chart, idPrefix = 'chart' } = Astro.props
const prefix = idPrefix.replace(/[^a-zA-Z0-9_-]/g, '-') || 'chart'
const id = `${prefix}-${chart.id}`
const left = 90
const top = 20
const plotWidth = 490
const plotHeight = 204
const count = chart.series.length
const values = chart.series.map((point) => point.value)
const minimum = values.reduce((low, value) => Math.min(low, value), 0)
const maximum = values.reduce((high, value) => Math.max(high, value), 0)
// Normalize before subtracting so even large finite positive/negative values
// cannot overflow the range. An all-zero series gets a harmless 0–1 axis.
const magnitude = Math.max(Math.abs(minimum), Math.abs(maximum)) || 1
const low = minimum / magnitude
const high = maximum === minimum ? 1 : maximum / magnitude
const span = high - low
const y = (value: number) => top + plotHeight * (1 - (value / magnitude - low) / span)
const x = (index: number) => chart.type === 'bar'
  ? left + (index + 0.5) * plotWidth / Math.max(count, 1)
  : left + (count > 1 ? index * plotWidth / (count - 1) : plotWidth / 2)
const baseline = y(0)
const barWidth = Math.min(64, plotWidth / Math.max(count, 1) * 0.65)
const ticks = Array.from({ length: 5 }, (_, index) => magnitude * (low + span * index / 4))
const tickStep = Math.max(1, Math.ceil((count - 1) / 2))
const labelTicks = chart.series.map((point, index) => ({ ...point, index }))
  .filter((point) => point.index % tickStep === 0 || point.index === count - 1)
const points = chart.series.map((point, index) => `${x(index)},${y(point.value)}`).join(' ')
const compact = (value: number) => {
  if (value === 0) return '0'
  const absolute = Math.abs(value)
  if (absolute >= 1e12 || absolute < 0.001)
    return value.toExponential(0).replace('e+', 'e')
  return new Intl.NumberFormat('en', { notation: 'compact', maximumSignificantDigits: 3 }).format(value)
}
const shortLabel = (label: string) => {
  const letters = Array.from(label)
  return letters.length > 10 ? `${letters.slice(0, 9).join('')}…` : label
}
---

<figure class="chart-figure" aria-labelledby={`${id}-heading`}>
  <div class="chart-heading">
    <h3 id={`${id}-heading`}>{chart.title}</h3>
    {chart.illustrative && <span class="chart-disclosure">Illustrative synthetic example</span>}
  </div>

  <svg
    class="chart-plot"
    viewBox="0 0 600 280"
    role="img"
    aria-labelledby={`${id}-title ${id}-description`}
  >
    <title id={`${id}-title`}>{chart.title}</title>
    <desc id={`${id}-description`}>
      {chart.caption} Units: {chart.unit}. All labels and exact values are available in the chart data table below.
    </desc>
    <g aria-hidden="true">
      {ticks.map((value) => (
        <g>
          <line class="chart-grid" x1={left} x2={left + plotWidth} y1={y(value)} y2={y(value)} />
          <text class="chart-axis-label" x={left - 12} y={y(value) + 5} text-anchor="end">{compact(value)}</text>
        </g>
      ))}
      <line class="chart-baseline" x1={left} x2={left + plotWidth} y1={baseline} y2={baseline} />

      {chart.type === 'bar' ? chart.series.map((point, index) => (
        <rect
          class="chart-bar"
          x={x(index) - barWidth / 2}
          y={y(point.value)}
          width={barWidth}
          height={Math.max(0, baseline - y(point.value))}
          rx="3"
          data-value={point.value}
          data-label={point.label}
        />
      )) : (
        <>
          <polyline class="chart-line" points={points} />
          {chart.series.map((point, index) => (
            <circle
              class="chart-point"
              cx={x(index)}
              cy={y(point.value)}
              r="5"
              data-value={point.value}
              data-label={point.label}
            />
          ))}
        </>
      )}

      {labelTicks.map((point) => (
        <text
          class="chart-axis-label chart-category"
          x={x(point.index)}
          y={top + plotHeight + 36}
          text-anchor={point.index === 0 ? 'start' : point.index === count - 1 ? 'end' : 'middle'}
        >{shortLabel(point.label)}</text>
      ))}
    </g>
  </svg>

  <figcaption>
    <p class="chart-caption">{chart.caption}</p>
    <p class="chart-meta"><strong>Units:</strong> {chart.unit}</p>
    <p class="chart-meta"><strong>Source:</strong> {chart.source}</p>
  </figcaption>

  <details class="chart-data">
    <summary>View chart data</summary>
    <table>
      <caption>{chart.title} — {chart.unit}</caption>
      <thead>
        <tr><th scope="col">Label</th><th scope="col">Value ({chart.unit})</th></tr>
      </thead>
      <tbody>
        {chart.series.map((point) => (
          <tr><th scope="row">{point.label}</th><td data-value={point.value}>{String(point.value)}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .chart-figure { min-width: 0; padding: clamp(1rem, 3vw, 1.75rem); border: 1px solid var(--line); border-radius: .8rem; background: var(--bg); }
  .chart-heading { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .chart-heading h3 { min-width: 0; font-size: 1.15rem; line-height: 1.35; overflow-wrap: anywhere; }
  .chart-disclosure { max-width: 100%; padding: .3rem .65rem; border-radius: .5rem; background: var(--highlight); color: var(--accent); font-size: .75rem; line-height: 1.5; overflow-wrap: anywhere; }
  .chart-plot { width: 100%; height: auto; margin-block: 1.5rem 1rem; overflow: visible; }
  .chart-grid { stroke: var(--line); stroke-width: 1; }
  .chart-baseline { stroke: var(--muted); stroke-width: 1.5; }
  .chart-axis-label { fill: var(--muted); font: 14px system-ui, sans-serif; }
  .chart-bar { fill: var(--accent); }
  .chart-line { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .chart-point { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }
  figcaption { overflow-wrap: anywhere; }
  .chart-caption { font-size: .95rem; line-height: 1.65; }
  .chart-meta { margin-top: .55rem; color: var(--muted); font-size: .8rem; line-height: 1.65; }
  .chart-meta strong { color: var(--ink); font-weight: 600; }
  .chart-data { margin-top: 1.25rem; border-top: 1px solid var(--line); }
  summary { padding-block: .9rem; color: var(--accent); cursor: pointer; font-size: .9rem; font-weight: 600; overflow-wrap: anywhere; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: .85rem; }
  caption { padding-block: .5rem 1rem; text-align: left; color: var(--muted); overflow-wrap: anywhere; }
  th, td { padding: .65rem .4rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
  th { font-weight: 600; }
  tbody th { font-weight: 400; }
  td { font-variant-numeric: tabular-nums; }
  @media (max-width: 500px) {
    .chart-axis-label { font-size: 22px; }
    .chart-category { font-size: 21px; }
  }
</style>
