---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { portfolio } from '../../lib/validate-content';
import type { Project } from '../../lib/validate-content';
import { sitePath, resourcePath } from '../../lib/paths';
import ProjectPreview from '../../components/ProjectPreview.astro';
import ChartFigure from '../../components/ChartFigure.astro';
import { statusLabels } from '../../lib/project-labels';
export function getStaticPaths() {
  return portfolio.projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
interface Props { project: Project; }
const index = portfolio.projects.findIndex(item => item.slug === project.slug);
const next = portfolio.projects[(index + 1) % portfolio.projects.length];
const status = statusLabels[project.status];
const dataLabel = { synthetic: 'Synthetic data', real: 'Real data', 'not-applicable': 'Not applicable', unconfirmed: 'Data source to be confirmed' }[project.dataKind];
const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'problem', label: 'Problem' },
  { id: 'technologies', label: 'Technologies' },
  { id: 'implementation', label: 'Implementation' },
  { id: 'demonstration', label: 'Demonstration' },
  { id: 'results', label: 'Results' },
  { id: 'challenges', label: 'Challenges and improvements' },
  { id: 'source-code', label: 'Source code' },
];
---
<BaseLayout title={`${project.title} — ${portfolio.profile.name}`} description={project.summary}>
  <div class="shell">
    <a class="back-link" href={sitePath('#projects')}>← All projects</a>
    <article aria-labelledby="case-title">
      <header class="case-header">
        <div>
          <p class="eyebrow">Project {String(index + 1).padStart(2, '0')} / {project.category}</p>
          <h1 id="case-title">{project.title}</h1>
          <p class="case-summary">{project.summary}</p>
          <div class="badge-row">
            <span class="badge">{status}</span>
            {project.dataKind === 'synthetic' && <span class="badge synthetic-badge">Synthetic data</span>}
            {project.contentDraft && <span class="badge">Case study draft</span>}
          </div>
          <div class="case-links">
            {project.links.github && <a href={project.links.github}>Source code <span aria-hidden="true">↗</span></a>}
            {project.links.demo && <a href={project.links.demo}>Live demo <span aria-hidden="true">↗</span></a>}
            {!project.links.github && !project.links.demo && <p class="muted">Code and demo links not yet available.</p>}
          </div>
        </div>
        <div id="project-preview"><ProjectPreview project={project} compact /></div>
      </header>
      <dl class="case-facts">
        <div><dt>Focus</dt><dd>{project.category}</dd></div>
        <div><dt>Built with</dt><dd>{project.tools.length ? project.tools.join(' · ') : 'Tools to be confirmed'}</dd></div>
        <div><dt>Project status</dt><dd>{status}</dd></div>
        <div><dt>Data</dt><dd>{dataLabel}</dd></div>
      </dl>
      {project.dataKind === 'synthetic' && <aside class="data-disclosure" aria-label="Data disclosure"><strong>Synthetic data, clearly stated.</strong><p>This project uses generated data. Any figures describe a synthetic example, not real listeners or real business activity. Verified sample calculations are identified separately from illustrative examples.</p></aside>}
      <div class="case-layout">
        <nav class="case-index" aria-label="On this page">
          <p class="eyebrow">In this project</p>
          <ol>{sections.map(section => <li><a href={`#${section.id}`}>{section.label}</a></li>)}</ol>
        </nav>
        <div class="case-content">
          <section class="case-section" id="overview" aria-labelledby="overview-heading">
            <p class="eyebrow">01 / At a glance</p><h2 id="overview-heading">Overview</h2>
            <p>{project.caseStudy.overview}</p>
          </section>
          <section class="case-section" id="problem" aria-labelledby="problem-heading">
            <p class="eyebrow">02 / The purpose</p><h2 id="problem-heading">Problem</h2>
            <p>{project.caseStudy.question}</p>
          </section>
          <section class="case-section" id="technologies" aria-labelledby="technologies-heading">
            <p class="eyebrow">03 / The tools</p><h2 id="technologies-heading">Technologies</h2>
            {project.tools.length ? <ul class="case-list">{project.tools.map(tool => <li>{tool}</li>)}</ul> : <p>The original technology stack cannot be verified from the available material.</p>}
          </section>
          <section class="case-section" id="implementation" aria-labelledby="implementation-heading">
            <p class="eyebrow">04 / How it works</p><h2 id="implementation-heading">Implementation</h2>
            <ul class="case-list">{project.caseStudy.approach.map(text => <li>{text}</li>)}</ul>
            {project.caseStudy.codeExample && <figure class="evidence-block"><figcaption>{project.caseStudy.codeExample.caption}</figcaption><pre tabindex="0" aria-label="Implementation code excerpt"><code>{project.caseStudy.codeExample.content}</code></pre></figure>}
          </section>
          <section class="case-section" id="demonstration" aria-labelledby="demonstration-heading">
            <p class="eyebrow">05 / Inspect the evidence</p><h2 id="demonstration-heading">Demonstration</h2>
            <p>{project.caseStudy.demonstration.description}</p>
            {project.image && <a class="text-link" href="#project-preview">View project screenshot above ↑</a>}
            {project.image && <p><a class="text-link" href={resourcePath(project.image)}>Open full-size screenshot ↗</a></p>}
            {project.caseStudy.demonstration.output && <figure class="evidence-block"><figcaption>{project.caseStudy.demonstration.output.caption}</figcaption><pre tabindex="0" aria-label="Verified sample report"><code>{project.caseStudy.demonstration.output.content}</code></pre></figure>}
          </section>
          <section class="case-section" id="results" aria-labelledby="results-heading">
            <p class="eyebrow">06 / What the work shows</p><h2 id="results-heading">Results</h2>
            {project.caseStudy.results.map(text => <p>{text}</p>)}
            {project.charts.map(chart => <ChartFigure chart={chart} idPrefix={project.slug} />)}
          </section>
          <section class="case-section" id="challenges" aria-labelledby="challenges-heading">
            <p class="eyebrow">07 / Limits and next steps</p><h2 id="challenges-heading">Challenges and improvements</h2>
            <h3>Known limitations</h3>
            <ul class="case-list">{project.caseStudy.limitations.map(text => <li>{text}</li>)}</ul>
            <h3>Future improvements</h3>
            <ul class="case-list">{project.caseStudy.nextSteps.map(text => <li>{text}</li>)}</ul>
          </section>
          <section class="case-section" id="source-code" aria-labelledby="source-code-heading">
            <p class="eyebrow">08 / Read the implementation</p><h2 id="source-code-heading">Source code</h2>
            {project.links.github ? <a class="text-link" href={project.links.github}>View source code on GitHub ↗</a> : <p>The source code is not currently available online.</p>}
          </section>
        </div>
      </div>
      {next && next.slug !== project.slug && <nav class="next-project" aria-label="Next project"><span class="eyebrow">Keep exploring</span><a href={sitePath(`projects/${next.slug}/`)}>{next.title}<span aria-hidden="true"> ↗</span></a></nav>}
    </article>
  </div>
</BaseLayout>

<style>
  .back-link { display: inline-flex; padding-block: .5rem; margin-top: 2.5rem; font-size: .8rem; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .case-header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: 5rem; align-items: center; padding-block: 3rem 4rem; }
  .case-header h1 { margin-block: 1rem 1.5rem; font-size: clamp(3rem, 5.7vw, 5.5rem); max-width: 13ch; overflow-wrap: break-word; font-weight: 500; }
  .case-summary { color: var(--muted); max-width: 54ch; }
  .case-links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.75rem; font-size: .85rem; }
  .case-links a { font-weight: 600; }
  .synthetic-badge { background: var(--highlight); border-color: transparent; color: var(--accent); }
  .case-facts { margin: 0; padding-block: 1.8rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--line); gap: 2rem; }
  dt { font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: .65rem; }
  dd { font-size: .85rem; margin: 0; overflow-wrap: anywhere; }
  .data-disclosure { padding: 1.5rem 1.75rem; border-left: 3px solid var(--accent); background: var(--panel); margin-block: 2.5rem; max-width: 900px; }
  .data-disclosure strong { font-size: .95rem; }
  .data-disclosure p { color: var(--muted); font-size: .85rem; margin-top: .5rem; }
  .case-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 5rem; margin-block: 3rem; }
  .case-index { padding-top: 1.5rem; }
  .case-index ol { list-style: decimal-leading-zero; padding-left: 1.4rem; color: var(--muted); font-size: .75rem; }
  .case-index li { padding-block: .45rem; padding-left: .3rem; }
  .case-index a { text-decoration: none; }
  .case-index a:hover { text-decoration: underline; }
  .case-content { min-width: 0; max-width: 880px; }
  .case-section { padding-block: 2.5rem; border-top: 1px solid var(--line); scroll-margin-top: 2rem; }
  .case-section h2 { font-weight: 500; font-size: clamp(1.8rem, 3vw, 2.5rem); margin-block: .75rem 1.4rem; }
  .case-section > p:not(.eyebrow), .case-list { font-size: 1rem; color: var(--muted); }
  .case-list { padding-left: 1.3rem; margin: 0; }
  .case-list li { padding-left: .3rem; margin-bottom: .8rem; }
  .case-list li::marker { color: var(--accent); }
  .case-section h3 { font-size: 1.05rem; margin-block: 1.8rem 1rem; letter-spacing: -.02em; }
  .evidence-block { margin-block: 1.5rem; border: 1px solid var(--line); border-radius: .6rem; padding: 1.2rem; min-width: 0; background: var(--panel); }
  .evidence-block figcaption { color: var(--muted); font-size: .8rem; margin-bottom: 1rem; overflow-wrap: anywhere; }
  .evidence-block pre { font: .85rem/1.8 ui-monospace, SFMono-Regular, Consolas, monospace; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  #project-preview { min-width: 0; scroll-margin-top: 2rem; }
  .next-project { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  .next-project a { font-size: clamp(1.3rem, 3vw, 2.3rem); letter-spacing: -.04em; text-decoration: none; }
  .next-project a:hover { text-decoration: underline; }
  @media (max-width: 1000px) { .case-header { gap: 2.5rem; } .case-layout { grid-template-columns: 170px minmax(0, 1fr); gap: 2.5rem; } }
  @media (max-width: 760px) {
    .case-header { grid-template-columns: 1fr; gap: 2rem; padding-block: 2rem; }
    .case-header h1 { font-size: clamp(2.7rem, 9vw, 4rem); }
    .case-facts { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .case-layout { grid-template-columns: 1fr; gap: 1rem; margin-block: 1.5rem; }
    .case-index { padding-block: 1rem; }
    .case-index ol { display: flex; flex-wrap: wrap; column-gap: 2.5rem; }
    .next-project { flex-direction: column; align-items: start; gap: 1rem; padding-block: 2rem; }
    .data-disclosure { padding: 1.2rem; }
  }
</style>
